# Discord 개발자 포털 > Bot > Token
DISCORD_TOKEN=
# Discord 개발자 포털 > General Information > Application ID
DISCORD_CLIENT_ID=
# 팀 서버 ID (Discord 개발자 모드에서 서버 우클릭 > ID 복사)
DISCORD_GUILD_ID=

# 이보다 짧은 발화(맞장구, 기침)는 버린다.
MIN_SEGMENT_MS=700

# compose 밖에서 npm start로 돌릴 때만 쓴다. compose 안에서는 docker-compose.yml 값을 쓴다.
RECORDINGS_DIR=./recordings
MEETING_ENDED_WEBHOOK_URL=http://localhost:5678/webhook/meeting-ended
